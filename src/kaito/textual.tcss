#app-grid {
    layout: grid;
    grid-size: 2 10;  /* two columns */
    grid-columns: 1fr 3fr;
    grid-rows: 1fr;
}

#left-pane {
    width: 100%;
    height: 100%;
    row-span: 10;
    margin-right: 2;
    /* background: purple; */
    border: dodgerblue;
}

#chat-container {
    width: 100%;
    height: 100%;
    row-span: 8;
    margin-right: 1;
    /* background: lightgrey; */
    border: orange;
}

#bottom-pane {
    width: 100%;
    height: 100%;
    row-span: 2;
    margin-right: 1;
    /* color: #0f2b41; */
    /* background: dodgerblue; */
}

Markdown.user-box {
    color: lavender;
    background: ansi_black;
}
Markdown.assistant-box {
    color: greenyellow;
    
}

Screen {
    align: center top;
    background: #300a24 100%;
}

Select {
    width: 100%;
    height: 3;
    /* margin-top: 1; */
    margin-bottom: 1;
}

Horizontal {
    align: left top;
    height: auto;
}

RadioSet {
    width: 100%;
    border: solid $accent;
}

SelectionList#tool_selection_list {
    padding: 1;
    border: solid $accent;
    width: 100%;
    height: 5%;
    min-height: 8;
}

SelectionList.file_sel_id {
    padding: 1;
    border: solid $accent;
    width: 100%;
    height: 20%;
    max-height: 40%;
    min-height: 8;
    visibility: hidden;
}


ImageViewer {
    min-width: 8;
    max-width: 50;
    min-height: 8;
    max-height: 50;
}

#input-box {
    height: auto;
    min-height: 100%;
    max-height: 100%;
    /* padding: 0; */
    border: solid green;
    width: 100%;
    padding-right: 2;
    align: right bottom;
}

#submit-button {
    height: auto;
    min-height: 100%;
    width: 20%;
    margin: 1;
    align: right bottom;
}
